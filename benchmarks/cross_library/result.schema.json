{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross-library benchmark JSONL row",
  "type": "object",
  "required": [
    "schema_version", "library", "library_version", "algorithm", "batch_method", "config",
    "problem_metadata", "evaluation_budget_total", "mode", "profile", "commit", "seed",
    "initial_data_id", "initial_data", "evaluation_count", "cumulative_cost", "metrics",
    "trajectory", "observed_batches", "timing", "environment", "status", "error"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "library": {"type": "string"},
    "library_version": {"type": ["string", "null"]},
    "algorithm": {"type": ["string", "null"]},
    "batch_method": {"type": ["string", "null"]},
    "config": {"type": "object", "required": ["problem", "strategy", "seeds", "initial_points", "evaluation_budget", "q"]},
    "problem_metadata": {"type": "object", "required": ["bounds", "directions", "variable_types", "n_constraints", "reference_point"]},
    "evaluation_budget_total": {"type": "integer", "minimum": 4},
    "mode": {"enum": ["A", "B", "C"]},
    "profile": {"enum": ["smoke", "standard"]},
    "commit": {"type": ["string", "null"]},
    "seed": {"type": "integer", "minimum": 0},
    "initial_data_id": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "initial_data": {"anyOf": [{"$ref": "#/$defs/batch"}, {"type": "null"}]},
    "evaluation_count": {"type": "integer", "minimum": 0},
    "cumulative_cost": {"type": "number", "minimum": 0},
    "metrics": {"type": ["object", "null"]},
    "trajectory": {"type": ["object", "null"]},
    "observed_batches": {"type": "array", "items": {"$ref": "#/$defs/batch"}},
    "timing": {
      "type": "object",
      "required": ["fit_seconds", "update_seconds", "total_seconds"],
      "properties": {
        "fit_seconds": {"type": ["number", "null"], "minimum": 0},
        "update_seconds": {"type": "number", "minimum": 0},
        "total_seconds": {"type": "number", "minimum": 0}
      }
    },
    "environment": {"type": "object"},
    "status": {"enum": [
      "ok", "unsupported", "dependency_error", "initialization_error", "initial_evaluation_error",
      "initial_update_error", "candidate_error", "evaluation_error", "update_error", "metrics_error"
    ]},
    "error": {"type": ["string", "null"]}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "ok"}}},
    "then": {"properties": {"trajectory": {"type": "object"}, "metrics": {"type": "object"}, "error": {"type": "null"}}},
    "else": {"properties": {"error": {"type": "string", "minLength": 1}}}
  }],
  "$defs": {
    "matrix": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}},
    "batch": {
      "type": "object",
      "required": ["X", "Y_observed", "constraints", "costs"],
      "properties": {
        "X": {"$ref": "#/$defs/matrix"},
        "Y_observed": {"$ref": "#/$defs/matrix"},
        "constraints": {"$ref": "#/$defs/matrix"},
        "costs": {"$ref": "#/$defs/matrix"}
      }
    }
  }
}
